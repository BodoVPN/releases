+
+// BodoVPN: auto-tuned response stream windows (core/patches/go/README.md). A stream starts at the
+// initial window and doubles, up to max, each time its reader takes a whole window's worth within
+// growWithin: the window, not the reader, is what limits it. A slow or stalled reader never grows.
+// A window granted to the peer can't be taken back, so a stream that grew and then stalls can still
+// buffer all of it; budget bounds that, process-wide: growth above every stream's initial window is
+// held from it until the response body is closed or fully read. Consumed bytes are always credited
+// back, so a spent budget only stops growth and no stream starves.
+type windowGrowth struct {
+	max    int32
+	budget int64
+
+	mu   sync.Mutex
+	used int64
+}
+
+// growWithin is how fast a reader must take a window's worth for the stream to grow. A window-bound
+// stream takes one per round trip, so 1 s covers round trips up to a second; a stream grows only to
+// about its rate times this.
+const growWithin = time.Second
+
+// grow is how much to add to a stream window of size window whose last window's worth was read in
+// elapsed: 0 for a slower reader, at max, or with the budget spent. It is held until release.
+func (g *windowGrowth) grow(window int32, elapsed time.Duration) int32 {
+	if g == nil || window >= g.max || elapsed > growWithin {
+		return 0
+	}
+	add := min(window, g.max-window)
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if left := g.budget - g.used; int64(add) > left {
+		add = int32(max(left, 0))
+	}
+	g.used += int64(add)
+	return add
+}
+
+func (g *windowGrowth) release(grown int32) {
+	if g == nil || grown == 0 {
+		return
+	}
+	g.mu.Lock()
+	g.used -= int64(grown)
+	g.mu.Unlock()
+}
+
+// releaseWindowGrowth returns the stream's growth to the budget, once.
+func (cs *clientStream) releaseWindowGrowth() {
+	cc := cs.cc
+	cc.mu.Lock()
+	grown := cs.grown
+	cs.grown = 0
+	cc.mu.Unlock()
+	cc.windowGrowth.release(grown)
+}
+
+var processGrowth struct {
+	sync.Mutex
+	g *windowGrowth
+}
+
+// processWindowGrowth is the process's windowGrowth from BODOCORE_H2_STREAM_WINDOW_MAX and
+// BODOCORE_H2_WINDOW_GROWTH_BUDGET, shared by every connection; nil while the max is unset.
+func processWindowGrowth() *windowGrowth {
+	maxWindow, budget := envInt32("BODOCORE_H2_STREAM_WINDOW_MAX"), envInt32("BODOCORE_H2_WINDOW_GROWTH_BUDGET")
+	if maxWindow <= 0 {
+		return nil
+	}
+	processGrowth.Lock()
+	defer processGrowth.Unlock()
+	if g := processGrowth.g; g == nil || g.max != maxWindow || g.budget != int64(budget) {
+		processGrowth.g = &windowGrowth{max: maxWindow, budget: int64(budget)}
+	}
+	return processGrowth.g
+}
+
+func envInt32(name string) int32 {
+	n, err := strconv.ParseInt(os.Getenv(name), 10, 32)
+	if err != nil || n < 0 {
+		return 0
+	}
+	return int32(n)
+}
diff --git a/src/net/http/internal/http2/transport_test.go b/src/net/http/internal/http2/transport_test.go
--- a/src/net/http/internal/http2/transport_test.go
+++ b/src/net/http/internal/http2/transport_test.go
@@ -5651,3 +5651,114 @@ func testExtendedConnectReadFrameError(t *testing.T) {
 		t.Fatalf("after connection closed: RoundTrip succeeded; want error")
 	}
 }
+
+// BodoVPN: auto-tuned stream windows (core/patches/go/README.md).
+func setWindowGrowthEnv(t *testing.T, window, maxWindow, budget int) {
+	t.Setenv("BODOCORE_H2_STREAM_WINDOW", strconv.Itoa(window))
+	t.Setenv("BODOCORE_H2_STREAM_WINDOW_MAX", strconv.Itoa(maxWindow))
+	t.Setenv("BODOCORE_H2_WINDOW_GROWTH_BUDGET", strconv.Itoa(budget))
+}
+
+// startWindowGrowthStream opens a GET and answers it with a 200, leaving the body to the test.
+func startWindowGrowthStream(t *testing.T, tc *testClientConn) (uint32, io.ReadCloser) {
+	req, _ := http.NewRequest("GET", "https://dummy.tld/", nil)
+	rt := tc.roundTrip(req)
+	tc.wantFrameType(FrameHeaders)
+	tc.writeHeaders(HeadersFrameParam{
+		StreamID:      rt.streamID(),
+		EndHeaders:    true,
+		BlockFragment: tc.makeHeaderBlockFragment(":status", "200"),
+	})
+	rt.wantStatus(200)
+	return rt.streamID(), rt.response().Body
+}
+
+// streamCredit sums the stream's WINDOW_UPDATE increments among the frames the client sent.
+func streamCredit(tc *testClientConn, streamID uint32) uint32 {
+	var credit uint32
+	for f := tc.readFrame(); f != nil; f = tc.readFrame() {
+		if wu, ok := f.(*WindowUpdateFrame); ok && wu.StreamID == streamID {
+			credit += wu.Increment
+		}
+	}
+	return credit
+}
+
+func newWindowGrowthClientConn(t *testing.T) *testClientConn {
+	tc := newTestClientConn(t, func(tr *http.Transport) {
+		tr.HTTP2 = &http.HTTP2Config{MaxReadFrameSize: 16 << 20}
+	})
+	tc.greet()
+	return tc
+}
+
+func TestTransportWindowGrowsWhileTheReaderKeepsUp(t *testing.T) {
+	setWindowGrowthEnv(t, 64<<10, 256<<10, 1<<20)
+	synctest.Test(t, testTransportWindowGrowsWhileTheReaderKeepsUp)
+}
+func testTransportWindowGrowsWhileTheReaderKeepsUp(t *testing.T) {
+	tc := newWindowGrowthClientConn(t)
+	id, body := startWindowGrowthStream(t, tc)
+	// Each round the server fills the window and the user reads it all: the client credits the
+	// bytes read plus the window's growth, doubling it until the max.
+	for _, round := range []struct{ fill, credit int }{
+		{64 << 10, 128 << 10},
+		{128 << 10, 256 << 10},
+		{256 << 10, 256 << 10},
+	} {
+		tc.writeData(id, false, make([]byte, round.fill))
+		if _, err := io.ReadFull(body, make([]byte, round.fill)); err != nil {
+			t.Fatalf("read %v bytes: %v", round.fill, err)
+		}
+		if got := streamCredit(tc, id); got != uint32(round.credit) {
+			t.Errorf("after reading %v bytes the stream got %v bytes of credit, want %v", round.fill, got, round.credit)
+		}
+	}
+}
+
+func TestTransportWindowStaysForAStalledReader(t *testing.T) {
+	setWindowGrowthEnv(t, 64<<10, 256<<10, 1<<20)
+	synctest.Test(t, testTransportWindowStaysForAStalledReader)
+}
+func testTransportWindowStaysForAStalledReader(t *testing.T) {
+	tc := newWindowGrowthClientConn(t)
+	id, body := startWindowGrowthStream(t, tc)
+	tc.writeData(id, false, make([]byte, 64<<10))
+	tc.wantIdle() // nothing read: no credit and no growth
+	// A reader that takes longer than growWithin over its window is slow: credit, no growth.
+	time.Sleep(2 * time.Second)
+	if _, err := io.ReadFull(body, make([]byte, 64<<10)); err != nil {
+		t.Fatalf("read: %v", err)
+	}
+	if got := streamCredit(tc, id); got != 64<<10 {
+		t.Errorf("credit = %v, want %v", got, 64<<10)
+	}
+}
+
+func TestTransportWindowGrowthSharesABudget(t *testing.T) {
+	setWindowGrowthEnv(t, 64<<10, 1<<20, 64<<10)
+	synctest.Test(t, testTransportWindowGrowthSharesABudget)
+}
+func testTransportWindowGrowthSharesABudget(t *testing.T) {
+	tc := newWindowGrowthClientConn(t)
+	a, bodyA := startWindowGrowthStream(t, tc)
+	b, bodyB := startWindowGrowthStream(t, tc)
+	readWindow := func(id uint32, body io.ReadCloser) uint32 {
+		tc.writeData(id, false, make([]byte, 64<<10))
+		if _, err := io.ReadFull(body, make([]byte, 64<<10)); err != nil {
+			t.Fatalf("read stream %v: %v", id, err)
+		}
+		return streamCredit(tc, id)
+	}
+	if got := readWindow(a, bodyA); got != 128<<10 {
+		t.Errorf("stream A credit = %v, want %v (the whole budget)", got, 128<<10)
+	}
+	if got := readWindow(b, bodyB); got != 64<<10 {
+		t.Errorf("stream B credit = %v, want %v (budget spent)", got, 64<<10)
+	}
+	bodyA.Close()
+	streamCredit(tc, a) // drain the RST_STREAM
+	if got := readWindow(b, bodyB); got != 128<<10 {
+		t.Errorf("stream B credit after A closed = %v, want %v", got, 128<<10)
+	}
+}
