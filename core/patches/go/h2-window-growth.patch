@@ -137,3 +137,50 @@ func TestOutFlowAddOverflow(t *testing.T) {
 	}
 
 }
+
+// BodoVPN: windowGrowth (core/patches/go/README.md).
+func TestWindowGrowthDoublesToItsMax(t *testing.T) {
+	g := &windowGrowth{max: 256 << 10, budget: 1 << 20}
+	window := int32(64 << 10)
+	var windows []int32
+	for add := g.grow(window, 0); add > 0; add = g.grow(window, 0) {
+		window += add
+		windows = append(windows, window)
+	}
+	if len(windows) != 2 || windows[0] != 128<<10 || windows[1] != 256<<10 {
+		t.Errorf("windows = %v, want [131072 262144]", windows)
+	}
+	if g.used != 192<<10 {
+		t.Errorf("used = %v, want %v", g.used, 192<<10)
+	}
+}
+
+func TestWindowGrowthNeedsAWindowWithinASecond(t *testing.T) {
+	g := &windowGrowth{max: 256 << 10, budget: 1 << 20}
+	if add := g.grow(64<<10, growWithin+1); add != 0 {
+		t.Errorf("grow after a slow window = %v, want 0", add)
+	}
+	if add := g.grow(64<<10, growWithin); add != 64<<10 {
+		t.Errorf("grow after a window in %v = %v, want %v", growWithin, add, 64<<10)
+	}
+}
+
+func TestWindowGrowthStopsAtTheBudgetUntilReleased(t *testing.T) {
+	g := &windowGrowth{max: 1 << 20, budget: 96 << 10}
+	a, b, c := g.grow(64<<10, 0), g.grow(64<<10, 0), g.grow(64<<10, 0)
+	if a != 64<<10 || b != 32<<10 || c != 0 {
+		t.Errorf("grows = %v, %v, %v; want 65536, 32768, 0", a, b, c)
+	}
+	g.release(a)
+	if d := g.grow(64<<10, 0); d != 64<<10 {
+		t.Errorf("grow after a release = %v, want %v", d, 64<<10)
+	}
+}
+
+func TestNilWindowGrowthNeverGrows(t *testing.T) {
+	var g *windowGrowth
+	if add := g.grow(64<<10, 0); add != 0 {
+		t.Errorf("nil grow = %v, want 0", add)
+	}
+	g.release(1)
+}
