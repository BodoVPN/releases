+// BodoVPN: compacting small payloads out of pooled frames (core/patches/quic-go/README.md).
+func TestReceiveStreamCompactsSmallPooledFrames(t *testing.T) {
+	t.Setenv("BODOCORE_QUIC_COMPACT_STREAM_FRAMES", "1")
+	str := newReceiveStream(42, nil, newTestStreamFlowController(42))
+	small := wire.GetStreamFrame()
+	small.Data = append(small.Data[:0], []byte("hello")...)
+	large := wire.GetStreamFrame()
+	large.Offset = 5
+	large.Data = large.Data[:1000]
+	for i := range large.Data {
+		large.Data[i] = 'x'
+	}
+	now := monotime.Now()
+	require.NoError(t, str.handleStreamFrame(small, now))
+	require.NoError(t, str.handleStreamFrame(large, now))
+	// Both went back to the pool (the large one queued behind unread data): overwriting their
+	// buffers must not reach the stream.
+	copy(small.Data[:cap(small.Data)][:5], "XXXXX")
+	copy(large.Data[:cap(large.Data)][:3], "YYY")
+	b := make([]byte, 1005)
+	n, err := io.ReadFull(&readerWithTimeout{Reader: str, Timeout: time.Second}, b)
+	require.NoError(t, err)
+	require.Equal(t, 1005, n)
+	require.Equal(t, "hello", string(b[:5]))
+	require.Equal(t, "xxx", string(b[5:8]))
+}
+
+func TestReceiveStreamKeepsPooledFramesWithoutCompaction(t *testing.T) {
+	t.Setenv("BODOCORE_QUIC_COMPACT_STREAM_FRAMES", "")
+	str := newReceiveStream(42, nil, newTestStreamFlowController(42))
+	require.False(t, str.compactFrames)
+}
