+// BodoVPN: a process-wide budget for stream receive windows' auto-tuned growth
+// (core/patches/quic-go/README.md). A window granted to the peer can't be taken back, so a stream
+// that grew while its reader kept up and then stalls can still buffer all of it; growth above each
+// stream's initial window is held from the budget until the stream's receive side is done. A spent
+// budget only stops growth, so no stream starves. BODOCORE_QUIC_STREAM_GROWTH_BUDGET sets it, in
+// bytes; unset, auto-tuning is stock.
+type streamGrowthBudget struct {
+	mu           sync.Mutex
+	budget, used protocol.ByteCount
+}
+
+func (b *streamGrowthBudget) take(n protocol.ByteCount) bool {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.used+n > b.budget {
+		return false
+	}
+	b.used += n
+	return true
+}
+
+func (b *streamGrowthBudget) release(n protocol.ByteCount) {
+	if n == 0 {
+		return
+	}
+	b.mu.Lock()
+	b.used -= n
+	b.mu.Unlock()
+}
+
+var processGrowth struct {
+	sync.Mutex
+	budget *streamGrowthBudget
+}
+
+// processStreamGrowthBudget is the budget every stream in the process shares, nil while unset.
+func processStreamGrowthBudget() *streamGrowthBudget {
+	n, err := strconv.ParseInt(os.Getenv("BODOCORE_QUIC_STREAM_GROWTH_BUDGET"), 10, 64)
+	if err != nil || n <= 0 {
+		return nil
+	}
+	processGrowth.Lock()
+	defer processGrowth.Unlock()
+	if b := processGrowth.budget; b == nil || b.budget != protocol.ByteCount(n) {
+		processGrowth.budget = &streamGrowthBudget{budget: protocol.ByteCount(n)}
+	}
+	return processGrowth.budget
+}
+
+// streamGrowMinRate is BODOCORE_QUIC_GROW_MIN_RATE in bytes per second, 64 KiB/s when unset.
+func streamGrowMinRate() float64 {
+	n, err := strconv.ParseInt(os.Getenv("BODOCORE_QUIC_GROW_MIN_RATE"), 10, 64)
+	if err != nil || n <= 0 {
+		return 64 << 10
+	}
+	return float64(n)
+}
