+// BodoVPN: the process growth budget (core/patches/quic-go/README.md).
+func TestStreamWindowGrowthBudget(t *testing.T) {
+	t.Setenv("BODOCORE_QUIC_STREAM_GROWTH_BUDGET", "100")
+	t.Setenv("BODOCORE_QUIC_GROW_MIN_RATE", "1")
+	rttStats := utils.NewRTTStats()
+	rttStats.UpdateRTT(time.Second, 0)
+	connFC := newConnectionFlowController(1000, 10000, func(protocol.ByteCount) bool { return true }, rttStats, utils.DefaultLogger)
+	newFC := func(id protocol.StreamID) *streamFlowController {
+		return newStreamFlowController(id, connFC, 100, 1000, protocol.MaxByteCount, rttStats, utils.DefaultLogger)
+	}
+	a, b := newFC(1), newFC(5)
+	now := monotime.Now()
+	require.NoError(t, a.UpdateHighestReceived(100, false, now))
+	require.NoError(t, b.UpdateHighestReceived(100, false, now))
+	now = now.Add(100 * time.Millisecond) // half the window read quickly: auto-tuning grows it
+
+	a.AddBytesRead(51)
+	require.Equal(t, protocol.ByteCount(51+200), a.GetWindowUpdate(now), "A's window doubles, taking the whole budget")
+	b.AddBytesRead(51)
+	require.Equal(t, protocol.ByteCount(51+100), b.GetWindowUpdate(now), "B stays at its window: the budget is spent")
+
+	a.ReleaseGrowth()
+	a.ReleaseGrowth() // only once
+	require.NoError(t, b.UpdateHighestReceived(151, false, now))
+	now = now.Add(100 * time.Millisecond)
+	b.AddBytesRead(51)
+	require.Equal(t, protocol.ByteCount(102+200), b.GetWindowUpdate(now), "B grows once A released its growth")
+}
+
+func TestStreamWindowGrowthWithoutABudgetIsStock(t *testing.T) {
+	t.Setenv("BODOCORE_QUIC_STREAM_GROWTH_BUDGET", "")
+	rttStats := utils.NewRTTStats()
+	rttStats.UpdateRTT(time.Second, 0)
+	connFC := newConnectionFlowController(1000, 10000, func(protocol.ByteCount) bool { return true }, rttStats, utils.DefaultLogger)
+	fc := newStreamFlowController(1, connFC, 100, 1000, protocol.MaxByteCount, rttStats, utils.DefaultLogger)
+	require.Nil(t, fc.growth)
+	now := monotime.Now()
+	require.NoError(t, fc.UpdateHighestReceived(100, false, now))
+	now = now.Add(time.Second)
+	fc.AddBytesRead(51)
+	require.Equal(t, protocol.ByteCount(51+200), fc.GetWindowUpdate(now))
+	fc.ReleaseGrowth()
+}
+
+func TestStreamWindowGrowthSkipsASlowReader(t *testing.T) {
+	t.Setenv("BODOCORE_QUIC_STREAM_GROWTH_BUDGET", "1000")
+	t.Setenv("BODOCORE_QUIC_GROW_MIN_RATE", "100") // bytes per second
+	// A loaded link: the RTT reads 10 s, so stock auto-tuning would grow a window read in 2 s.
+	rttStats := utils.NewRTTStats()
+	rttStats.UpdateRTT(10*time.Second, 0)
+	connFC := newConnectionFlowController(1000, 10000, func(protocol.ByteCount) bool { return true }, rttStats, utils.DefaultLogger)
+	fc := newStreamFlowController(1, connFC, 100, 1000, protocol.MaxByteCount, rttStats, utils.DefaultLogger)
+	now := monotime.Now()
+	require.NoError(t, fc.UpdateHighestReceived(100, false, now))
+	now = now.Add(2 * time.Second) // 51 bytes in 2 s: under 100 B/s
+	fc.AddBytesRead(51)
+	require.Equal(t, protocol.ByteCount(51+100), fc.GetWindowUpdate(now), "a slow reader keeps its window")
+
+	fast := newStreamFlowController(5, connFC, 100, 1000, protocol.MaxByteCount, rttStats, utils.DefaultLogger)
+	require.NoError(t, fast.UpdateHighestReceived(100, false, now))
+	now = now.Add(100 * time.Millisecond) // 51 bytes in 0.1 s: over 100 B/s
+	fast.AddBytesRead(51)
+	require.Equal(t, protocol.ByteCount(51+200), fast.GetWindowUpdate(now), "a reader above the rate grows")
+}
